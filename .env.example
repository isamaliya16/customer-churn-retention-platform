# Copy to `.env` . Every value is optional:
# with an empty/default file the app runs on SQLite + an in-process cache.

FLASK_ENV=development

# Secrets - CHANGE THESE for anything other than local use.
# In production (FLASK_ENV=production) the app REFUSES to start unless both are >= 32 random characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# --- Optional: PostgreSQL (recommended for production; default is SQLite) ---
# DATABASE_URL=postgresql+psycopg2://churn_user:churn_pass@localhost:5432/churn_db
# TEST_DATABASE_URL=postgresql+psycopg2://churn_user:churn_pass@localhost:5432/churn_test_db

# --- Optional: Redis for caching + rate limiting (default is in-process) ---
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1
# CACHE_DEFAULT_TIMEOUT=600

# --- JWT lifetimes ---
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Rate limits ---
RATE_LIMIT_PREDICT=100 per minute
RATE_LIMIT_DEFAULT=300 per minute
RATE_LIMIT_LOGIN=20 per minute
RATE_LIMIT_BATCH=10 per minute

# --- Accounts ---
# Self-service analyst sign-up is OFF by default (new accounts can read all customer data).
# Create users as an admin (POST /auth/register with an admin token) or with `flask create-admin`.
# ALLOW_PUBLIC_REGISTRATION=false

# --- CORS (the bundled dashboard is same-origin, so this is only for other frontends) ---
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080

# --- Risk tiers ---
RISK_LOW_MAX=0.25
RISK_MEDIUM_MAX=0.50
